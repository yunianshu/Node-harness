{
  "$schema": "./plugin-schema.json",
  "pluginId": "novel-harness",
  "displayName": "多模型长篇小说生成",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "cordis": {
    "name": "novel-harness",
    "inject": []
  },
  "commands": [
    { "name": "novel.create", "description": "创建小说项目" },
    { "name": "novel.start", "description": "启动生成" },
    { "name": "novel.pause", "description": "暂停生成" },
    { "name": "novel.resume", "description": "恢复生成" },
    { "name": "novel.stop", "description": "终止项目" },
    { "name": "novel.status", "description": "进度查询（两级视图）" },
    { "name": "novel.report", "description": "总结报告" },
    { "name": "novel.export", "description": "合并全文/交付包导出" },
    { "name": "novel.guidance.add", "description": "附加指导意见（仅暂停态）" },
    { "name": "novel.guidance.regen", "description": "指导重生成" },
    { "name": "novel.admin.provider", "description": "服务商/凭据管理" },
    { "name": "novel.regenerate", "description": "失败章重入队" }
  ],
  "profiles": ["novel"],
  "bundles": {
    "novel-full": ["novel-harness"]
  },
  "storage": {
    "dataRootRelative": "novels",
    "credentials": "host-managed"
  },
  "loadMode": "npm-or-local-path",
  "notes": "凭据全部经 HostProvider 写入底座加密体系；本插件不存储任何明文 API Key/订阅 token。"
}